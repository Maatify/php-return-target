{
    "name": "maatify/php-return-target",
    "description": "PHP library package foundation for return-target handling.",
    "keywords": [
        "return-target",
        "php",
        "maatify"
    ],
    "homepage": "https://github.com/Maatify/php-return-target",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Maatify",
            "email": "support@maatify.dev",
            "homepage": "https://maatify.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/Maatify/php-return-target/issues",
        "source": "https://github.com/Maatify/php-return-target"
    },
    "autoload": {
        "psr-4": {
            "Maatify\\ReturnTarget\\": "src/"
        }
    },
    "require": {
        "php": "^8.4"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "fail"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
